# The one required setting: where the neighborhood data repo is. A local path or a git URL.
DATA_REPO=https://github.com/The-Relational-Technology-Project/outer-sunset
# owner/repo on GitHub, for PRs and links (derived from DATA_REPO when it's a GitHub URL)
# DATA_REPO_GITHUB=The-Relational-Technology-Project/outer-sunset
# DATA_REPO_BRANCH=main

# The model. Haiku first; raise if the golden questions need it.
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5
# Search by meaning (optional). With a key, search blends full-text with embeddings, so "somewhere to
# borrow a ladder" finds the sharing library. Without one, search is full-text alone. What is sent to
# the embeddings service: the public records' text, and the words of each search. Nothing about who asked.
# VOYAGE_API_KEY=
# EMBED_MODEL=voyage-4-lite
# EMBED_URL=https://api.voyageai.com/v1/embeddings   (any endpoint in the same shape, e.g. one you host)
# Daily hard stop in dollars. The agent says "I'm resting" past this.
DAILY_BUDGET_USD=5
# Prices used for the budget math, dollars per million tokens (Haiku 5.5 defaults)
INPUT_USD_PER_MILLION=0.10
OUTPUT_USD_PER_MILLION=0.50
# Messages per person per ten minutes
RATE_LIMIT_PER_TEN_MINUTES=20

# Source keys named by key_env in sources.yml. This is the site's publishable (anon) key,
# the same one its public pages ship to every browser; ask the site's steward for it.
COMMUNITY_SUPPLIES_ANON_KEY=
# NPS_API_KEY=DEMO_KEY

# GitHub App installed on the data repo, scoped to Contents (read/write) and Pull requests (read/write),
# plus Issues (read/write) for the contact form. PRs come from the app's bot identity.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_INSTALLATION_ID=   (found automatically when omitted)
# GITHUB_WEBHOOK_SECRET=    (optional: POST /api/webhook/github on push to rebuild at once)

# Serverless hosts (Vercel): read the data repo through the GitHub API with this token (any read-only
# token; a fine-grained PAT with public repo access is enough) to avoid the anonymous rate limit,
# and sign PR drafts with this secret so they survive across instances.
# GITHUB_TOKEN=
# DRAFT_SECRET=

# Email to stewards (Resend). Sender must be on a domain verified in Resend.
RESEND_API_KEY=
# EMAIL_FROM=Knowy Plover <knowy@relationaltechproject.org>
# STEWARD_EMAILS=   (default: the addresses in the data repo's STEWARDS.md)

# Asking a neighbor. Names and emails of neighbors who offered to be asked are kept as Resend
# contacts (RESEND_API_KEY must have full access, not send-only), never in the data repo.
# Set CONTACT_STORE=file to keep them in CACHE_DIR instead (needs a disk that persists).
# Links in those emails are sealed with DRAFT_SECRET; set it to a long random string.
# CONTACT_STORE=resend
# SITE_URL=https://knowy.org

# How often to check the data repo for merges when no webhook is set
REPO_POLL_MINUTES=5
PORT=3000
# CACHE_DIR=.cache
